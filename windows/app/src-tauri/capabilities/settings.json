{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "Lets the Settings and tour windows listen for events, call the settings commands and drag the title-less tour.",
  "windows": [
    "settings",
    "tour"
  ],
  "permissions": [
    "core:event:default",
    "core:window:allow-start-dragging",
    "allow-get-settings",
    "allow-update-settings",
    "allow-start-hotkey-pick",
    "allow-cancel-hotkey-pick",
    "allow-check-microphone",
    "allow-open-microphone-privacy",
    "allow-reset-widget-position",
    "allow-widget-demo",
    "allow-finish-tour",
    "allow-show-tour",
    "allow-detect-agents"
  ]
}
