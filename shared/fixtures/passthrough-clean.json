{
  "version": 1,
  "description": "PassthroughFormatter.clean: collapse whitespace and capitalize.",
  "cases": [
    {
      "name": "CleanCollapsesWhitespaceAndCapitalizes/1",
      "input": {
        "text": "  добре,   зараз\nподивлюсь "
      },
      "expected": "Добре, зараз подивлюсь"
    },
    {
      "name": "CleanCollapsesWhitespaceAndCapitalizes/2",
      "input": {
        "text": ""
      },
      "expected": ""
    },
    {
      "name": "Graphemes/SpaceWithMark",
      "input": {
        "text": "a ́b"
      },
      "expected": "A b"
    },
    {
      "name": "Graphemes/FirstClusterMarkUppercase",
      "input": {
        "text": "ᾳ β"
      },
      "expected": "ΑΙ β"
    },
    {
      "name": "Graphemes/CrLf",
      "input": {
        "text": "a\r\nb"
      },
      "expected": "A b"
    }
  ]
}
