          },
          {
            "key": "up",
            "at": 1.1
          }
        ]
      },
      "expected": [
        {
          "output": "press_began"
        },
        {
          "output": "short_tap"
        },
        {
          "output": "press_began"
        },
        {
          "output": "short_tap"
        }
      ]
    },
