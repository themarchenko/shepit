              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld пункту потребують уваги."
                }
              }
            }
          }
        }
      }
    },
    "A dash that springs into a pill. Words float above it." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Риска, що розкривається в пігулку. Слова спливають над нею."
          }
        }
      }
    },
    "A password field is active; nothing was inserted" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Активне поле пароля, нічого не вставлено"
          }
        }
      }
    },
    "A wide bar that reads like subtitles. Best for long prompts." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Широка смуга, як субтитри. Найкраще для довгих промптів."
          }
        }
      }
    },
    "Accessibility" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Універсальний доступ"
