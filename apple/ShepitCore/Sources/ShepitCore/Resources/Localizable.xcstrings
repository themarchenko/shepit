    },
    "Allowed." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозволено."
          }
        }
      }
    },
    "Allowed. Shepit can paste into other apps." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозволено. Shepit може вставляти текст в інші програми."
