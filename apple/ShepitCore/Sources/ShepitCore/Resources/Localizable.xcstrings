        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Правий Option (⌥)"
          }
        }
      }
    },
    "Secure input" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Захищене введення"
          }
        }
      }
    },
    "Shepit has not asked for the microphone yet." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shepit ще не запитував доступ до мікрофона."
          }
        }
      }
    },
    "Shepit is running from a temporary copy macOS made for it. Move Shepit to Applications, open it from there and update again." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shepit запущено з тимчасової копії, яку створила macOS. Перемістіть Shepit у «Програми», відкрийте його звідти й оновіть ще раз."
          }
        }
      }
    },
    "Shepit usually works without it. Allow it only if the dictation key does not respond." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зазвичай Shepit працює й без цього. Дозвольте, лише якщо клавіша диктування не реагує."
          }
        }
      }
    },
    "Speech model" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Модель мовлення"
          }
        }
      }
    },
    "Switch Shepit on in the list." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увімкніть Shepit у списку."
          }
        }
      }
    },
    "System" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Як у системі"
          }
        }
      }
    },
    "Test" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевірити"
          }
        }
      }
    },
    "The agent answered with something Shepit could not read." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shepit не зміг прочитати відповідь агента."
          }
        }
      }
    },
    "The agent did not answer in time. Try again in a moment." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Агент не відповів вчасно. Спробуйте за хвилину."
          }
        }
      }
    },
    "The agent is not running." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Агент не запущено."
          }
        }
      }
    },
    "The agent is paused after repeated failures. Try again later." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Агент призупинено після повторних збоїв. Спробуйте пізніше."
          }
        }
      }
    },
    "The agent reported an error. It may be signed out or out of quota." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Агент повідомив про помилку. Можливо, ви вийшли з облікового запису або вичерпано квоту."
          }
        }
      }
    },
    "The agent stopped unexpectedly. Check that it is installed and signed in." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Агент несподівано зупинився. Перевірте, чи його інстальовано і чи ви ввійшли в обліковий запис."
          }
        }
      }
    },
    "The agent test failed for an unknown reason." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевірка агента не вдалася з невідомої причини."
          }
        }
      }
    },
    "The download is not a newer Shepit (%@)." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завантажений файл не є новішою версією Shepit (%@)."
          }
        }
      }
