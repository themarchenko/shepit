{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ failed: %@" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Помилка %@: %@"
          }
        }
      }
    },
    "%@ has secure input on, so Shepit cannot paste. Close or leave its password field." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Захищене введення ввімкнено (%@), тому Shepit не може вставити текст. Закрийте програму або вийдіть з поля пароля."
          }
        }
      }
    },
    "%@ is downloaded and loads when needed." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завантажено: %@. Запускається за потреби."
          }
        }
      }
    },
    "%@ is ready." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Готово: %@."
          }
        }
      }
    },
    "%@ was not found on this Mac." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не знайдено на цьому Mac."
          }
        }
      }
    },
    "%lld things need attention." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld thing needs attention."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld things need attention."
                }
              }
            }
          }
        },
        "uk" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld пункт потребує уваги."
                }
              },
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld пункти потребують уваги."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld пунктів потребують уваги."
                }
